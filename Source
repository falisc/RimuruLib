  local SideMouseProbes = {
      Mouse4 = {
           Code = 0x05,
           Button = 4,
           Names = {"mouse4", "Mouse4", "mousebutton4", "MouseButton4", "xbutton1", "XButton1", "forward", "Forward"},
          Functions = hostFunctionList({"ismouse4pressed", "isMouse4Pressed", "isxbutton1pressed", "isXButton1Pressed"}),
      },
