  function Window:_animateOverlay(panel, visible, instant, slide)
      self.OverlayAnimations = self.OverlayAnimations or {}
      local state = self.OverlayAnimations[panel]
      if not state then state = {Position = panel.Position, Tweens = {}, Serial = 0, Completed = true}; self.OverlayAnimations[panel] = state end
      if not visible and panel.Visible and state.Completed ~= false then state.Position = panel.Position end
      state.Serial = (state.Serial or 0) + 1
      local transitionSerial = state.Serial
      state.Completed = false
      for _, tween in ipairs(state.Tweens) do tween:Cancel() end
      state.Tweens = {}
      local function remember(object)
          if object:IsA("GuiObject") then
              state.Background = state.Background or {}; if state.Background[object] == nil then state.Background[object] = object.BackgroundTransparency end
          end
          if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
              state.Text = state.Text or {}; if state.Text[object] == nil then state.Text[object] = object.TextTransparency end
          end
          if object:IsA("ImageLabel") or object:IsA("ImageButton") then
              state.Image = state.Image or {}; if state.Image[object] == nil then state.Image[object] = object.ImageTransparency end
          end
          if object:IsA("UIStroke") then
              state.Stroke = state.Stroke or {}; if state.Stroke[object] == nil then state.Stroke[object] = object.Transparency end
          end
          if object:IsA("ScrollingFrame") then
              state.ScrollBar = state.ScrollBar or {}; if state.ScrollBar[object] == nil then state.ScrollBar[object] = object.ScrollBarImageTransparency end
          end
      end
      remember(panel)
      for _, child in ipairs(panel:GetDescendants()) do remember(child) end
      local info = TweenInfo.new(.18, Enum.EasingStyle.Quad, visible and Enum.EasingDirection.Out or Enum.EasingDirection.In)
      local slideOffset = slide == false and 0 or (visible and 0 or 6)
      local targetPosition = UDim2.new(state.Position.X.Scale, state.Position.X.Offset, state.Position.Y.Scale, state.Position.Y.Offset + slideOffset)
      if instant then
          panel.Position = visible and state.Position or targetPosition
          panel.Visible = visible
          if visible then
              for object, base in pairs(state.Background or {}) do if object and object.Parent then object.BackgroundTransparency = base end end
              for object, base in pairs(state.Text or {}) do if object and object.Parent then object.TextTransparency = base end end
              for object, base in pairs(state.Image or {}) do if object and object.Parent then object.ImageTransparency = base end end
              for object, base in pairs(state.Stroke or {}) do if object and object.Parent then object.Transparency = base end end
              for object, base in pairs(state.ScrollBar or {}) do if object and object.Parent then object.ScrollBarImageTransparency = base end end
          else
              for object in pairs(state.Background or {}) do if object and object.Parent then object.BackgroundTransparency = 1 end end
              for object in pairs(state.Text or {}) do if object and object.Parent then object.TextTransparency = 1 end end
              for object in pairs(state.Image or {}) do if object and object.Parent then object.ImageTransparency = 1 end end
              for object in pairs(state.Stroke or {}) do if object and object.Parent then object.Transparency = 1 end end
              for object in pairs(state.ScrollBar or {}) do if object and object.Parent then object.ScrollBarImageTransparency = 1 end end
          end
          state.Completed = true
          return
      end
      if visible then
          panel.Position = UDim2.new(state.Position.X.Scale, state.Position.X.Offset, state.Position.Y.Scale, state.Position.Y.Offset + slideOffset)
          panel.Visible = true
      end
      local function fade(objects, property, target)
          for object, base in pairs(objects or {}) do
              if object and object.Parent then
                  if visible then object[property] = 1 end
                  local tween = TweenService:Create(object, info, {[property] = visible and base or 1})
                  table.insert(state.Tweens, tween); tween:Play()
              end
          end
      end
      fade(state.Background, "BackgroundTransparency")
      fade(state.Text, "TextTransparency")
      fade(state.Image, "ImageTransparency")
      fade(state.Stroke, "Transparency")
      fade(state.ScrollBar, "ScrollBarImageTransparency")
      local positionTween = TweenService:Create(panel, info, {Position = targetPosition})
      table.insert(state.Tweens, positionTween); positionTween:Play()
      if not visible then
          positionTween.Completed:Connect(function()
              if state.Serial ~= transitionSerial then return end
              state.Completed = true
              local hideDelay = 0
              task.delay(hideDelay, function()
                  if state.Serial == transitionSerial and self.OverlayAnimations and self.OverlayAnimations[panel] == state and panel.Parent then panel.Visible = false end
              end)
          end)
      else
          positionTween.Completed:Connect(function()
              if state.Serial == transitionSerial then state.Completed = true end
          end)
      end
  end

  function Window:_applyTheme()
      if not self.Gui then return end
      local previous = self.ActiveThemePalette or RimuruDark
      local palette = ThemePalettes[self.ThemeName] or RimuruDark
      local colourKeys = {"Background", "Surface", "Card", "Hover", "Border", "Text", "Muted", "Disabled", "Divider", "Accent", "Selected"}
      local function remap(value)
          for _, key in ipairs(colourKeys) do
              if value == previous[key] then return Theme[key] end
          end
          return value
      end
      for _, object in ipairs(self.Gui:GetDescendants()) do
          local role = object:GetAttribute("RimuruThemeRole")
          if object:IsA("GuiObject") then
              if role == "WindowBackground" then
                  object.BackgroundColor3 = Theme.Background
                  object.BackgroundTransparency = Theme.WindowTransparency or 0
              elseif role == "PanelOutline" then
                  object.BackgroundColor3 = Theme.Border
                  object.BackgroundTransparency = 0
              elseif role == "SectionCard" then
                  object.BackgroundColor3 = Theme.Card
                  object.BackgroundTransparency = Theme.SectionTransparency or 0
              elseif role == "Card" then
                  object.BackgroundColor3 = Theme.Card
                  object.BackgroundTransparency = Theme.CardTransparency or 0
               elseif role == "Surface" or role == "FloatingSurface" then
                   object.BackgroundColor3 = Theme.Surface
                   object.BackgroundTransparency = Theme.SurfaceTransparency or 0
               elseif role == "FloatingSurfaceChild" then
                   object.BackgroundColor3 = Theme.Surface
                   object.BackgroundTransparency = 1
               elseif role == "KeybindRow" then
                   local active = object:GetAttribute("RimuruKeybindActive") == true
                   object.BackgroundColor3 = active and Theme.Selected or Theme.Surface
                   object.BackgroundTransparency = active and 0 or 1
              elseif role == "Sidebar" then
                  object.BackgroundColor3 = Theme.Sidebar or Theme.Surface
                  object.BackgroundTransparency = Theme.SidebarTransparency or 0
               elseif role == "FrostedTab" then
                   local active = object:GetAttribute("RimuruActiveTab") == true
                   object.BackgroundColor3 = active and Theme.Selected or Theme.Surface
                   object.BackgroundTransparency = Theme.SurfaceTransparency or 0
              else
                  local previousBackground = object.BackgroundColor3
                  object.BackgroundColor3 = remap(previousBackground)
                  if previousBackground == previous.Surface or previousBackground == Theme.Surface then
                      object.BackgroundTransparency = Theme.SurfaceTransparency or 0
                  elseif previousBackground == previous.Card or previousBackground == previous.Selected or previousBackground == Theme.Card or previousBackground == Theme.Selected then
                      object.BackgroundTransparency = Theme.CardTransparency or 0
                  elseif previousBackground == previous.Background or previousBackground == Theme.Background then
                      object.BackgroundTransparency = Theme.WindowTransparency or 0
                  end
              end
          end
          if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
              object.TextColor3 = remap(object.TextColor3)
              if object:IsA("TextBox") then object.PlaceholderColor3 = remap(object.PlaceholderColor3) end
          elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
              object.ImageColor3 = remap(object.ImageColor3)
              if object:GetAttribute("RimuruIconImage") then
                  local tintMode = object:GetAttribute("RimuruIconTintMode")
                  if tintMode == "logo" then object.ImageColor3 = Color3.new(1, 1, 1)
                  elseif tintMode == "text" then object.ImageColor3 = Theme.Text
                  elseif tintMode == "muted" then object.ImageColor3 = Theme.Muted end
              end
          elseif object:IsA("ScrollingFrame") then
              object.ScrollBarImageColor3 = remap(object.ScrollBarImageColor3)
          elseif object:IsA("UIStroke") then
              object.Color = remap(object.Color)
          end
      end
      if self.Outer then self.Outer.BackgroundColor3 = Theme.Border end
      self.ActiveThemePalette = copyTheme(palette)
      if self.Atmosphere then
          local background = self.Atmosphere.ThemeBackground
          local asset = ResolveAsset(Theme.BackgroundImage)
          if background then
              background.Image = asset or ""
              background.ImageTransparency = Theme.BackgroundImageTransparency or 1
          end
          local screensaver = self.Atmosphere.Screensaver
          if screensaver then
              screensaver.Image = asset or ""
              screensaver.ImageTransparency = 0
          end
          self.Atmosphere.Darkening.BackgroundColor3 = Color3.new(0, 0, 0)
          self:_refreshAtmosphere()
      end
  end

