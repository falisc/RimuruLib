      local baseHeight = 36 + segmentHeight
      local count = #(self.Notifications or {})
      local targetHeight = baseHeight + count * 74
      self.NotificationHost.Position = UDim2.fromOffset(0, baseHeight)
      TweenService:Create(self.Watermark, TweenInfo.new(.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.fromOffset(390, targetHeight)}):Play()
