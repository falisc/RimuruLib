  function Window:_createAtmosphere()
      local shade = New("Frame", {Active = false, BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = .52, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = true, ZIndex = 0}, self.Gui)
      local backgroundAsset = ResolveAsset(Theme.BackgroundImage)
      local background = New("ImageLabel", {Active = false, BackgroundTransparency = 1, BorderSizePixel = 0, Image = backgroundAsset or "", ImageTransparency = Theme.BackgroundImageTransparency or 1, Name = "RimuruThemeBackground", ScaleType = Enum.ScaleType.Crop, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 0}, self.Root)
      Corner(background, 12)
      local screensaver = New("ImageLabel", {Active = false, BackgroundTransparency = 1, BorderSizePixel = 0, Image = backgroundAsset or "", ImageTransparency = 0, Name = "RimuruScreensaver", ScaleType = Enum.ScaleType.Crop, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 0}, self.Gui)
      local rain = New("Frame", {Active = false, BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true, Size = UDim2.fromScale(1, 1), Visible = true, ZIndex = 0}, self.Gui)
      local drops = {}
      for index = 1, 44 do
          local length = math.random(8, 17)
           local drop = New("Frame", {BackgroundColor3 = Theme.Muted, BackgroundTransparency = .46, BorderSizePixel = 0, Position = UDim2.fromOffset(math.random(0, 1200), math.random(-900, 800)), Rotation = -19, Size = UDim2.fromOffset(1, length), ZIndex = 0}, rain)
          drops[index] = {Object = drop, X = drop.Position.X.Offset, Y = drop.Position.Y.Offset, Speed = math.random(420, 680), Length = length}
      end
       local connection
       connection = RunService.RenderStepped:Connect(function(delta)
           if not rain.Parent then
               if connection then connection:Disconnect(); connection = nil end
               return
           end
          if not rain.Visible then return end
          local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
          for _, drop in ipairs(drops) do
              drop.X += drop.Speed * .34 * delta
              drop.Y += drop.Speed * delta
              if drop.Y > viewport.Y + drop.Length or drop.X > viewport.X + 80 then
                  drop.Y = -drop.Length
                  drop.X = math.random(-120, math.max(1, viewport.X - 40))
              end
              drop.Object.Position = UDim2.fromOffset(drop.X, drop.Y)
          end
      end)
      self.Atmosphere = {Darkening = shade, Rain = rain, ThemeBackground = background, Screensaver = screensaver, Connection = connection}
      self.DarkeningEnabled, self.RainEnabled = true, true
      self.ScreensaverEnabled = self.Config.Screensaver == true
      self:_refreshAtmosphere()
