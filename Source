  function Window:_configFolderPath()
      return self.ConfigFolder ~= "" and self.ConfigFolder or "RimuruConfigs"
  end

  function Window:_configFileName(name)
      local requested = name ~= nil and tostring(name) or ""
      local value = requested ~= "" and requested or tostring(self.ConfigName or "")
      value = value:gsub("[^%w%-%_ ]", ""):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
      return value ~= "" and value or "Default"
  end

  function Window:_configPath(name)
      return self:_configFolderPath() .. "/" .. self:_configFileName(name) .. ".json"
  end

  function Window:_configIndexPath()
      return self:_configFolderPath() .. "/.rimuru-index.json"
  end

  function Window:_loadConfigIndex()
      if self.ConfigIndexLoaded then return end
      self.ConfigIndexLoaded = true
      local path = self:_configIndexPath()
      if not FileExists(path) then return end
      local ok, names = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
      if not ok or type(names) ~= "table" then return end
      self.ConfigNames = self.ConfigNames or {}
      for _, name in ipairs(names) do
          local filename = self:_configFileName(name)
          if filename ~= "Default" or tostring(name) == "Default" then self.ConfigNames[filename] = true end
      end
  end

  function Window:_saveConfigIndex()
      self:_loadConfigIndex()
      local names = {}
      for name in pairs(self.ConfigNames or {}) do names[#names + 1] = name end
      table.sort(names)
      local ok, text = pcall(function() return HttpService:JSONEncode(names) end)
      if not ok then return false end
      return WriteFile(self:_configIndexPath(), text)
  end

  function Window:_captureConfig()
      local values = {}
       for tabIndex, tab in ipairs(self.Tabs or {}) do
           for sectionIndex, section in ipairs(tab.Sections or {}) do
               for widgetIndex, widget in ipairs(section.Widgets or {}) do
                  if not widget.ConfigIgnore then
                      local snapshot
                       if widget.Keybind then
                           local enabled = nil
                           if widget.Box then enabled = widget.Value == true end
                           snapshot = {Kind = "Keybind", Enabled = enabled, Key = tostring(widget.Keybind.KeyName or "Unbound"), Mode = tostring(widget.Keybind.Mode or "TOGGLE")}
                      elseif widget.Box then
                          snapshot = {Kind = "Checkbox", Value = widget.Value == true}
                      elseif widget.Swatch and typeof(widget.Value) == "Color3" then
                          snapshot = {Kind = "Color", R = widget.Value.R, G = widget.Value.G, B = widget.Value.B, Transparency = tonumber(widget.Transparency) or 0}
                      elseif widget.Input then
                          snapshot = {Kind = "Input", Value = widget.Input.Text}
                      elseif widget.Value ~= nil then
                          snapshot = {Kind = type(widget.Value) == "table" and "DropdownMulti" or "Value", Value = widget.Value}
                      end
                       if snapshot then values[string.format("v2:%d:%d:%d", tabIndex, sectionIndex, widgetIndex)] = snapshot end
                  end
              end
          end
      end
        return {Version = 2, Theme = self.ThemeName or "Rimuru Dark", AutoSave = self.ConfigAutoSave == true, Values = values}
  end

  function Window:_configSnapshotText()
      local ok, text = pcall(function() return HttpService:JSONEncode(self:_captureConfig()) end)
      return ok and text or ""
  end

  function Window:SaveConfig(name)
      local folder = self:_configFolderPath()
      EnsureFilesystemFolder(folder)
      local ok, text = pcall(function() return HttpService:JSONEncode(self:_captureConfig()) end)
      if not ok then return false end
      local configName = self:_configFileName(name)
      local path = self:_configPath(configName)
      local wrote = WriteFile(path, text)
      if wrote then
          self.ConfigNames = self.ConfigNames or {}
          self.ConfigNames[configName] = true
          self:_saveConfigIndex()
          self.ConfigName = configName
          if self.ConfigNameWidget and self.ConfigNameWidget.Set then self.ConfigNameWidget.Set(configName, true) end
          self._lastConfigSnapshot = text
          if self.AutoLoadWidget and self.AutoLoadWidget.SetOptions then
              self.AutoLoadWidget.SetOptions(self:_configOptions())
              if self.AutoLoadWidget.Set then self.AutoLoadWidget.Set(configName) end
          end
      end
      return wrote
  end

  function Window:_configOptions()
      local options = {"None"}
      self:_loadConfigIndex()
      local seen = {}
      for filename in pairs(self.ConfigNames or {}) do
          if filename ~= "" and not seen[filename] then
              seen[filename] = true
              options[#options + 1] = filename
          end
      end
      if type(listfiles) == "function" then
          local ok, files = pcall(listfiles, self:_configFolderPath())
          if ok and type(files) == "table" then
              for _, path in ipairs(files) do
                  local filename = string.match(tostring(path), "([^/\\\\]+)%.json$")
                  if filename and filename ~= "" and filename ~= ".rimuru-index" and not seen[filename] then
                      seen[filename] = true
                      options[#options + 1] = filename
                  end
              end
          end
      end
      local currentName = self:_configFileName(self.ConfigName)
      if currentName ~= "Default" or self.ConfigName == "Default" then
          if FileExists(self:_configPath(currentName)) and not seen[currentName] then
              seen[currentName] = true
              options[#options + 1] = currentName
          end
      end
      table.sort(options, function(a, b)
          if a == "None" then return b ~= "None" end
          if b == "None" then return false end
          return a < b
      end)
      return options
  end

  function Window:_findConfigWidget(name)
      local tabIndex, sectionIndex, widgetIndex = tostring(name):match("^v2:(%d+):(%d+):(%d+)$")
      if tabIndex then
          local tab = self.Tabs[tonumber(tabIndex)]
          local section = tab and tab.Sections[tonumber(sectionIndex)]
          local widget = section and section.Widgets[tonumber(widgetIndex)]
          if widget then return widget end
      end
      for _, tab in ipairs(self.Tabs or {}) do
          for _, section in ipairs(tab.Sections or {}) do
              for _, widget in ipairs(section.Widgets or {}) do
                   if widget.Name == name or (widget.Name == "Floating Island" and name == "Watermark") then return widget end
              end
          end
      end
  end

  function Window:_applyConfig(data)
       local values = type(data) == "table" and data.Values or nil
       if type(values) ~= "table" then return false end
       if data.Theme then self:SetTheme(data.Theme) end
       if data.AutoSave ~= nil then
           self.ConfigAutoSave = data.AutoSave == true
           if self.AutoSaveWidget and self.AutoSaveWidget.Set then self.AutoSaveWidget.Set(self.ConfigAutoSave, true) end
       end
       for name, snapshot in pairs(values) do
          local widget = self:_findConfigWidget(name)
          if widget and type(snapshot) == "table" then
               if snapshot.Kind == "Checkbox" and widget.Set then
                   widget.Set(snapshot.Value == true)
               elseif snapshot.Kind == "Color" and widget.Set then
                   widget.Set(Color3.new(tonumber(snapshot.R) or 1, tonumber(snapshot.G) or 1, tonumber(snapshot.B) or 1))
                   if widget.SetTransparency then widget.SetTransparency(tonumber(snapshot.Transparency) or 0) end
               elseif snapshot.Kind == "Input" and widget.Set then
                   widget.Set(snapshot.Value)
               elseif snapshot.Kind == "Keybind" and widget.Keybind then
                  local key = canonicalInputName(snapshot.Key or "Unbound")
                  if key == "Backspace" or key == "None" or key == "Unknown" then key = "Unbound" end
                  if key == "Unbound" or self:_keybindAvailable(key, widget.Keybind) then
                      widget.Keybind.KeyName = key
                       widget.Keybind.Button.Text = key
                       widget.Keybind.Mode = string.upper(tostring(snapshot.Mode or widget.Keybind.Mode or "TOGGLE"))
                        if snapshot.Enabled ~= nil and widget.Set then widget.Set(snapshot.Enabled == true) end
                       if widget.Keybind.IsUIToggle then self:SetUIToggleKeybind(key) end
                       self:_refreshKeybindOverlay(widget.Keybind)
                   end
               elseif widget.Set then
                   widget.Set(snapshot.Value)
              end
          end
      end
      return true
  end

  function Window:LoadConfig(name)
      local configName = self:_configFileName(name)
      local path = self:_configPath(configName)
      if not FileExists(path) then return false end
      local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
      if not ok then return false end
      local applied = self:_applyConfig(decoded)
      if applied then
          self.ConfigNames = self.ConfigNames or {}
          self.ConfigNames[configName] = true
          self:_saveConfigIndex()
          self.ConfigName = configName
          if self.ConfigNameWidget and self.ConfigNameWidget.Set then self.ConfigNameWidget.Set(configName, true) end
          if self.AutoLoadWidget and self.AutoLoadWidget.Set then self.AutoLoadWidget.Set(configName) end
          self._lastConfigSnapshot = self:_configSnapshotText()
      end
      return applied
  end

  function Window:CreateConfig(name)
      if name ~= nil then
          self.ConfigName = tostring(name)
          if self.ConfigNameWidget and self.ConfigNameWidget.Set then self.ConfigNameWidget.Set(self.ConfigName, true) end
      end
      return self:SaveConfig()
  end

  function Window:RefreshConfigs()
      if self.AutoLoadWidget and self.AutoLoadWidget.SetOptions then self.AutoLoadWidget.SetOptions(self:_configOptions()) end
      return true
  end

  function Window:DeleteConfig(name)
      local target = tostring(name or self.ConfigName or "")
      if target == "" and self.AutoLoadWidget and type(self.AutoLoadWidget.Value) == "string" then target = self.AutoLoadWidget.Value end
      if target == "" or target == "None" then return false end
      local configName = self:_configFileName(target)
      local path = self:_configPath(configName)
      if not FileExists(path) then return false end
      local deleted = DeleteFile(path)
      if deleted then
          if self.ConfigNames then self.ConfigNames[configName] = nil end
          self:_saveConfigIndex()
          if self.ConfigName == configName then self.ConfigName = "" end
          self:RefreshConfigs()
      end
      return deleted
  end

  function Window:_startConfigWatcher()
      task.spawn(function()
          while self.Gui and self.Gui.Parent do
              task.wait(.5)
              if self.ConfigAutoSave then
                  local snapshot = self:_configSnapshotText()
                  if snapshot ~= "" and snapshot ~= self._lastConfigSnapshot then self:SaveConfig() end
              else
                  self._lastConfigSnapshot = self:_configSnapshotText()
              end
          end
      end)
  end

