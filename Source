  function Window:_drag(root, ...)
      local start, origin, dragging = nil, nil, false
      local window = self
      local function begin(input)
          if input.UserInputType == Enum.UserInputType.MouseButton1 then
              if window.WindowTween then window.WindowTween:Cancel() end
              if window.OuterTween then window.OuterTween:Cancel() end
              if window.DragTween then window.DragTween:Cancel() end
              dragging, start, origin = true, input.Position, root.Position
          end
      end
      for _, handle in ipairs({...}) do
          handle.InputBegan:Connect(begin)
      end
      UIS.InputChanged:Connect(function(input)
          if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
              local delta = input.Position - start
              local target = UDim2.new(origin.X.Scale, origin.X.Offset + delta.X, origin.Y.Scale, origin.Y.Offset + delta.Y)
              if window.DragTween then window.DragTween:Cancel() end
              window.DragTween = TweenService:Create(root, TweenInfo.new(.045, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = target})
              window.DragTween:Play()
              if window.OuterDragTween then window.OuterDragTween:Cancel() end
              window.OuterDragTween = TweenService:Create(window.Outer, TweenInfo.new(.045, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = target})
              window.OuterDragTween:Play()
              if window.Minimized then
                  local minimizedOffset = (window.NormalHeight - (window.MinimizedHeight or 58)) / 2
                  window.NormalPosition = UDim2.new(target.X.Scale, target.X.Offset, target.Y.Scale, target.Y.Offset + minimizedOffset)
              else
                  window.NormalPosition = target
              end
          end
      end)
      UIS.InputEnded:Connect(function(input)
           if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
      end)
  end
  function Window:_popupPosition(anchor, width, height)
      local position, size = anchor.AbsolutePosition, anchor.AbsoluteSize
      local x, y = position.X, position.Y + size.Y + 4
      local layerPosition = self.PopupLayer and self.PopupLayer.AbsolutePosition or Vector2.new(0, 0)
      local camera = workspace.CurrentCamera
      if camera then
           local viewport = camera.ViewportSize
           if x + width > viewport.X - 6 then x = viewport.X - width - 6 end
           x = math.max(6, x)
           if y + height > viewport.Y - 6 then y = position.Y - height - 4 end
           y = math.max(6, y)
      end
      return UDim2.fromOffset(math.floor(x - layerPosition.X), math.floor(y - layerPosition.Y))
  end
  function Window:_placePopup(popup, anchor, width, height)
      popup.AnchorPoint = Vector2.new(0, 0)
      popup.Position = self:_popupPosition(anchor, width, height)
  end
