      local b = Label(card, message, 11, Theme.Muted); b.Position = UDim2.fromOffset(12, 29); b.Size = UDim2.new(1, -24, 0, 20)
      if fromWatermark then a.TextTransparency, b.TextTransparency = 1, 1 end
      if fromWatermark then New("Frame", {BackgroundColor3 = Theme.Divider, BorderSizePixel = 0, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 0, 1), ZIndex = 43}, card) end
      local timer = math.max(tonumber(duration) or 3, .1)
      local track = New("Frame", {BackgroundColor3 = Theme.Divider, BorderSizePixel = 0, Position = UDim2.new(0, 12, 1, -7), Size = UDim2.new(1, -24, 0, 2), ZIndex = 31}, card); Corner(track, 1)
      local fill = New("Frame", {BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 32}, track); Corner(fill, 1)
      TweenService:Create(fill, TweenInfo.new(timer, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 1, 0)}):Play()
      local entry = {Card = card}
      table.insert(window.Notifications, 1, entry)
      local function reflow()
          for index, current in ipairs(window.Notifications) do
              if current.Card and current.Card.Parent then
                  local target = fromWatermark and UDim2.fromOffset(0, (index - 1) * 74) or UDim2.new(1, -18, 0, 18 + (index - 1) * 76)
                  TweenService:Create(current.Card, TweenInfo.new(.24, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = target}):Play()
              end
          end
           if fromWatermark and window.Watermark and window.NotificationHost then window:_refreshFloatingIslandLayout() end
      end
      reflow()
      if fromWatermark then
           TweenService:Create(card, TweenInfo.new(.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 66), BackgroundTransparency = 1}):Play()
          TweenService:Create(a, TweenInfo.new(.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
          TweenService:Create(b, TweenInfo.new(.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency = 0}):Play()
      end
      task.delay(timer, function()
          if not card.Parent then return end
          local exitPosition = fromWatermark and UDim2.fromOffset(0, card.Position.Y.Offset - 6) or UDim2.new(1, 18, 0, card.Position.Y.Offset)
          local exitProps = fromWatermark and {Position = exitPosition, Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1} or {Position = exitPosition}
          TweenService:Create(card, TweenInfo.new(.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), exitProps):Play()
          if fromWatermark then
              TweenService:Create(a, TweenInfo.new(.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1}):Play()
              TweenService:Create(b, TweenInfo.new(.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {TextTransparency = 1}):Play()
          end
          task.delay(.2, function()
              Remove(card)
              for index, current in ipairs(window.Notifications) do
                  if current == entry then table.remove(window.Notifications, index); break end
              end
              reflow()
          end)
      end)
