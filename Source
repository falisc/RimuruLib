  local function canonicalInputName(name)
      name = tostring(name or "")
      local lowerName = string.lower(name)
       if lowerName == "mouse4" or lowerName == "mousebutton4" or lowerName == "mousebuttonx1" or lowerName == "xbutton1" or lowerName == "forward" then return "Mouse4" end
       if lowerName == "mouse5" or lowerName == "mousebutton5" or lowerName == "mousebuttonx2" or lowerName == "xbutton2" or lowerName == "back" then return "Mouse5" end
      return name
  end
  local function isMouseBindingName(name)
      name = canonicalInputName(name)
      return name == "Mouse4" or name == "Mouse5"
  end
  local function isBindableName(name)
      name = canonicalInputName(name)
      if name == "Unbound" then return true end
      if isMouseBindingName(name) then return true end
      return Enum.KeyCode[name] ~= nil
  end
  local function bindableInputName(input)
      if not input then return nil end
      local inputType = input.UserInputType
      if inputType == Enum.UserInputType.Keyboard then
          return input.KeyCode and input.KeyCode.Name or nil
      end
      local inputTypeName = inputType and inputType.Name or ""
      if isMouseBindingName(inputTypeName) then return canonicalInputName(inputTypeName) end
      return nil
  end
  local function isMouseBindableInput(input)
      return isMouseBindingName(input and input.UserInputType and input.UserInputType.Name or "")
  end
  local function sideMouseDown(name)
      local probe = SideMouseProbes[canonicalInputName(name)]
      if not probe then return false end
      local function pressed(value)
          return value == true or value == 1
      end
      for _, probeFunction in ipairs(probe.Functions) do
          if probeFunction then
              local ok, down = pcall(probeFunction)
              if ok and pressed(down) then return true end
          end
      end
      if isMouseButtonPressed then
          local ok, down = pcall(isMouseButtonPressed, probe.Button)
          if ok and pressed(down) then return true end
          ok, down = pcall(isMouseButtonPressed, probe.Code)
          if ok and pressed(down) then return true end
      end
      if isKeyPressed then
          local ok, down = pcall(isKeyPressed, probe.Code)
          if ok and pressed(down) then return true end
          for _, probeName in ipairs(probe.Names) do
              ok, down = pcall(isKeyPressed, probeName)
              if ok and pressed(down) then return true end
          end
      end
      return false
  end
  local function PopupBlocks(button)
      local gui = button and button:FindFirstAncestorOfClass("ScreenGui")
      local layer = gui and gui:FindFirstChild("RimuruPopupLayer")
      local backdrop = layer and layer:FindFirstChild("RimuruPopupBackdrop")
      return backdrop and backdrop.Visible and not button:IsDescendantOf(layer)
  end
  local function Hover(button)
      button.MouseEnter:Connect(function() if PopupBlocks(button) then return end; TweenService:Create(button, TweenInfo.new(.12), {BackgroundColor3 = Theme.Hover}):Play() end)
      button.MouseLeave:Connect(function() TweenService:Create(button, TweenInfo.new(.12), {BackgroundColor3 = Theme.Card}):Play() end)
  end
  local function ClickTween(button)
      local scale = New("UIScale", {Scale = 1}, button)
      local pressed = false
      local function restore() TweenService:Create(scale, TweenInfo.new(.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1}):Play() end
      button.MouseButton1Down:Connect(function() pressed = true; TweenService:Create(scale, TweenInfo.new(.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = .96}):Play() end)
      button.MouseButton1Up:Connect(function() pressed = false; restore() end)
      button.MouseLeave:Connect(function() if not pressed then restore() end end)
      local ended = UIS.InputEnded:Connect(function(input)
          if input.UserInputType == Enum.UserInputType.MouseButton1 then pressed = false; restore() end
      end)
      button.AncestryChanged:Connect(function(_, parent) if not parent and ended then ended:Disconnect(); ended = nil end end)
  end
