      local name
      if type(identifyexecutor) == "function" then
          local ok, detected = pcall(identifyexecutor)
          if ok and detected ~= nil then name = detected end
      end
      if (name == nil or tostring(name) == "") and type(getexecutorname) == "function" then
          local ok, detected = pcall(getexecutorname)
          if ok and detected ~= nil then name = detected end
      end
