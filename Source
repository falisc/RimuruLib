  function Window:_pointInside(object, point)
      if not object or not object.Visible then return false end
      local position, size = object.AbsolutePosition, object.AbsoluteSize
      return point.X >= position.X and point.X <= position.X + size.X and point.Y >= position.Y and point.Y <= position.Y + size.Y
  end
  function Window:ClosePopup()
      local state = self.PopupState
      self.PopupState = nil
      if self.PopupBackdrop then self.PopupBackdrop.Visible = false end
      if state and state.Object and state.Object.Parent then
          local object = state.Object
          local panel = state.Panel or object
          local width = math.max(panel.AbsoluteSize.X, 1)
          local closing = TweenService:Create(panel, TweenInfo.new(.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.fromOffset(width, 0)})
          closing:Play()
          task.delay(.13, function() if object and object.Parent then Remove(object) end end)
      end
  end
  function Window:OpenPopup(object, anchor, panel)
      self:ClosePopup()
      local pending = self.PendingKeybind
      if pending then pending.Cancel() end
      if self.PopupBackdrop then self.PopupBackdrop.Visible = true end
      if object and anchor then
          self:_placePopup(object, anchor, object.Size.X.Offset, object.Size.Y.Offset)
          object.Visible = true
      end
      self.PopupState = {Object = object, Anchor = anchor, Panel = panel or object}
  end
  function Window:SetVisible(value)
      value = value == true
       if self.Minimized and self.MinimizedAttached then return end
       if self.UIKeybindEntry and self.UIKeybindEntry.SetActive then self.UIKeybindEntry.SetActive(value, true) end
        if self.Visible == value and ((self.Root and self.Root.Visible) == value) then return end
        self.Visible = value
        self:_refreshAtmosphere()
      if self.VisibilityTweens then
          for _, tween in ipairs(self.VisibilityTweens) do tween:Cancel() end
      end
      self.VisibilityTweens = {}
      if self.WindowVisibilityScaleTween then self.WindowVisibilityScaleTween:Cancel(); self.WindowVisibilityScaleTween = nil end
      if self.WindowVisibilityOuterScaleTween then self.WindowVisibilityOuterScaleTween:Cancel(); self.WindowVisibilityOuterScaleTween = nil end
       if value then
           self.Root.Visible = true
           self.Outer.Visible = true
           if self.RootScale then self.RootScale.Scale = 1 end
           if self.OuterScale then self.OuterScale.Scale = 1 end
           self:_resetTabVisuals()
       else
           self:ClosePopup()
       end
       -- Use the same fade-only timeline as minimize/restore. The old Back
       -- scale tweens caused the visible mid-animation hitch.
       self:_animateOverlay(self.Root, value, false, false)
       self:_animateOverlay(self.Outer, value, false, false)
  end

  function Window:SetUIToggleKeybind(key)
      local name = canonicalInputName(typeof(key) == "EnumItem" and key.Name or tostring(key or "RightAlt"))
      if name == "Backspace" or name == "None" or name == "Unknown" then name = "Unbound" end
       if name ~= "Unbound" and not isBindableName(name) then name = "RightAlt" end
      self.UIKeybindName = name
        if self.UIKeybindEntry and self.UIKeybindEntry.Button then
            self.UIKeybindEntry.KeyName = name
            self.UIKeybindEntry.Button.Text = name
            if self.UIKeybindEntry.SetActive then self.UIKeybindEntry.SetActive(self.Root and self.Root.Visible == true, true) end
        end
       if self.UIKeybindConnection then self.UIKeybindConnection:Disconnect() end
       self.UIKeybindConnection = UIS.InputBegan:Connect(function(input, processed)
           local inputName = bindableInputName(input)
           local mouseInput = isMouseBindableInput(input)
           if inputName then self:_rememberSideMouseInput(inputName, true) end
           if not self.MinimizedAttached and (not processed or mouseInput) and inputName == self.UIKeybindName then
                 self:SetVisible(not self.Visible)
           end
       end)
       self:_refreshKeybindOverlay()
  end

  function Window:_keybindAvailable(keyName, except)
      keyName = canonicalInputName(keyName or "None")
       if keyName == "None" or keyName == "Unknown" or keyName == "Unbound" then return true end
       for _, entry in ipairs(self.Keybinds or {}) do
           if entry ~= except and tostring(entry.KeyName or (entry.Button and entry.Button.Text) or "None") == keyName then return false end
       end
      return true
  end
  function Window:_rememberSideMouseInput(inputName, down)
      inputName = canonicalInputName(inputName)
      if not isMouseBindingName(inputName) then return end
      self.SideMouseDown = self.SideMouseDown or {}
      self.SideMouseDown[inputName] = down == true
  end
  function Window:_pollSideMouseBindings()
      if not self.Gui or not self.Gui.Parent then return end
      self.SideMouseDown = self.SideMouseDown or {Mouse4 = false, Mouse5 = false}
      for _, inputName in ipairs({"Mouse4", "Mouse5"}) do
          local down = sideMouseDown(inputName)
          local wasDown = self.SideMouseDown[inputName] == true
          self.SideMouseDown[inputName] = down
          if down and not wasDown then
              local pending = self.PendingKeybind
              if pending and pending.Capture then
                  pending.Capture(inputName)
              else
                  if self.UIKeybindName == inputName and not self.MinimizedAttached then self:SetVisible(not self.Visible) end
                  for _, entry in ipairs(self.Keybinds or {}) do
                      if entry.KeyName == inputName and entry.HandleBegan then entry.HandleBegan(inputName, false) end
                  end
              end
          elseif not down and wasDown then
              for _, entry in ipairs(self.Keybinds or {}) do
                  if entry.KeyName == inputName and entry.HandleEnded then entry.HandleEnded(inputName) end
              end
          end
      end
  end

