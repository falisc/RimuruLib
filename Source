  local function MakeIcon(parent, kind, assets, size, tint)
      kind = string.lower(tostring(kind or "dot"))
      size = size or 16
       local imageTint = kind == "logo" and Color3.new(1, 1, 1) or (tint == false and Theme.Text or (tint == true and Theme.Text or (typeof(tint) == "Color3" and tint or Theme.Muted)))
      local asset = (type(assets) == "table" and assets[kind]) or DefaultIconAssets[kind]
      asset = ResolveAsset(asset)
      if asset then
           local image = New("ImageLabel", {BackgroundTransparency = 1, BorderSizePixel = 0, Image = tostring(asset), ImageColor3 = imageTint, ScaleType = Enum.ScaleType.Fit, Size = UDim2.fromOffset(size, size), ZIndex = 4}, parent)
           image:SetAttribute("RimuruIconImage", true)
           image:SetAttribute("RimuruIconKind", kind)
           image:SetAttribute("RimuruIconTintMode", kind == "logo" and "logo" or (tint == false or tint == true) and "text" or (typeof(tint) == "Color3" and "explicit" or "muted"))
           return image
       end
       if kind == "info" then
           local icon = New("Frame", {BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromOffset(size, size), ZIndex = 4}, parent)
           Corner(icon, size / 2); Outline(icon, imageTint)
           IconPart(icon, {BackgroundColor3 = imageTint, Position = UDim2.fromOffset(size / 2 - 1, 5), Size = UDim2.fromOffset(2, 2), ZIndex = 5})
           IconPart(icon, {BackgroundColor3 = imageTint, Position = UDim2.fromOffset(size / 2 - 1, 9), Size = UDim2.fromOffset(2, size - 12), ZIndex = 5})
           return icon
       elseif kind == "terminal" then
           local icon = New("Frame", {BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromOffset(size, size), ZIndex = 4}, parent)
           local upper = IconPart(icon, {BackgroundColor3 = imageTint, Position = UDim2.fromOffset(3, size / 2 - 4), Size = UDim2.fromOffset(size * .42, 2), Rotation = 32, ZIndex = 5})
           local lower = IconPart(icon, {BackgroundColor3 = imageTint, Position = UDim2.fromOffset(3, size / 2 + 1), Size = UDim2.fromOffset(size * .42, 2), Rotation = -32, ZIndex = 5})
           Corner(upper, 1); Corner(lower, 1)
