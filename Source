  local function DecodeBase64(data)
      data = string.gsub(tostring(data or ""), "[^%w%+/=]", "")
      return (data:gsub(".", function(character)
          if character == "=" then return "" end
          local value = string.find(Base64Alphabet, character, 1, true) - 1
          local bits = ""
          for bit = 6, 1, -1 do bits = bits .. ((value % 2 ^ bit - value % 2 ^ (bit - 1) > 0) and "1" or "0") end
          return bits
      end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(bits)
          if #bits ~= 8 then return "" end
          local value = 0
          for bit = 1, 8 do if bits:sub(bit, bit) == "1" then value += 2 ^ (8 - bit) end end
          return string.char(value)
      end))
  end
  local function WriteIconAssets(data)
      if type(data) ~= "table" or type(writefile) ~= "function" then return end
      for path, bytes in pairs(data) do
          local folder = string.match(tostring(path), "^(.*)[/\\\\][^/\\\\]+$")
          if folder and type(makefolder) == "function" then
              local current = ""
              for segment in string.gmatch(folder, "[^/\\\\]+") do
                  current = current == "" and segment or current .. "/" .. segment
                  pcall(makefolder, current)
              end
          end
          pcall(writefile, path, DecodeBase64(bytes))
      end
  end
  local function EnsureFilesystemFolder(path)
      if type(makefolder) ~= "function" then return false end
      local current = ""
      local attempted = false
      for segment in string.gmatch(tostring(path or ""), "[^/\\\\]+") do
          current = current == "" and segment or current .. "/" .. segment
          attempted = true
          pcall(makefolder, current)
      end
      if not attempted then return false end
      if type(isfolder) == "function" then
          local ok, exists = pcall(isfolder, tostring(path))
          return ok and exists == true
      end
      return true
  end

